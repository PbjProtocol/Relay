{
  "name": "@pbjpro/relay",
  "version": "1.2.1",
  "description": "TypeScript SDK for Relay's USDC milestone escrow protocol",
  "license": "MIT",
  "author": "PBJ Protocol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbjprotocol/relay-js.git"
  },
  "homepage": "https://0xpbj.pro",
  "bugs": {
    "url": "https://github.com/pbjprotocol/relay-js/issues"
  },
  "keywords": [
    "relay",
    "escrow",
    "usdc",
    "solana",
    "milestones",
    "pbj-protocol"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
